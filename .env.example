NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

DB_PATH=./database/balcony.db

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=5242880

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BalconyPro <noreply@balconypro.ru>"

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI renovation advisor (Claude). Get a key at https://console.anthropic.com/.
# Leave empty to disable the AI chat (the widget degrades gracefully).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6).
ANTHROPIC_MODEL=

# Admin API token — protects order listings, catalogue mutations, statistics.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable admin endpoints entirely (fail-closed).
ADMIN_API_TOKEN=
