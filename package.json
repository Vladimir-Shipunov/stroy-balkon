{
  "name": "balcony-configurator-pro",
  "version": "2.0.0",
  "description": "Профессиональный конфигуратор отделки балконов с 3D визуализацией",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "build:three": "esbuild src/three-bundle.js --bundle --format=iife --global-name=__threeSetup --outfile=public/vendor/three.global.js --minify",
    "build": "npm run build:three && npm run check",
    "check": "node scripts/smoke-test.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.js"
  },
  "keywords": [
    "balcony",
    "configurator",
    "3d",
    "visualization",
    "construction"
  ],
  "author": "BalconyConfig Team",
  "license": "MIT",
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "axios": "^1.6.2",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "swiper": "^12.2.0",
    "three": "^0.184.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
