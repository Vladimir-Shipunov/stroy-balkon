{
  "name": "balcony-configurator-pro",
  "version": "2.0.0",
  "description": "Конфигуратор отделки балконов: готовые 2D-сцены, материалы, мебель и свет",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "build": "npm run build:app && npm run check",
    "check": "node scripts/smoke-test.js",
    "test:server": "node --test \"server/__tests__/**/*.test.js\"",
    "test:geometry": "node --experimental-strip-types --import ./scripts/register-ts-esm-loader.mjs --test \"src/pages/Configurator/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:geometry-tests": "tsc --noEmit -p tsconfig.test.json",
    "dev:app": "vite",
    "build:app": "vite build",
    "preview:app": "vite preview",
    "test": "node scripts/smoke-test.js"
  },
  "keywords": [
    "balcony",
    "configurator",
    "visualization",
    "construction"
  ],
  "author": "BalconyConfig Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@phosphor-icons/web": "^2.1.2",
    "axios": "^1.6.2",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "swiper": "^12.2.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "adm-zip": "^0.5.17",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.3",
    "sharp": "^0.35.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
